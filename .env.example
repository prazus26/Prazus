# ==========================================
# PRAZUS - CONFIGURAÇÃO DE AMBIENTE
# ==========================================
# Arquivo de exemplo para os desenvolvedores.
#
# Copie este arquivo para .env e configure
# suas próprias credenciais.
#
# NUNCA envie o arquivo .env ao GitHub.
# ==========================================


# ==========================================
# 1. BANCO DE DADOS - MYSQL
# ==========================================

# Formato:
# mysql+pymysql://USUARIO:SENHA@localhost:3306/prazus_db

DATABASE_URL=


# ==========================================
# 2. SEGURANÇA - FLASK
# ==========================================

# Chave utilizada para proteger as sessões.
# Cada desenvolvedor deve gerar sua própria.

SECRET_KEY=


# ==========================================
# 3. INTELIGÊNCIA ARTIFICIAL - GEMINI
# ==========================================

# Chave de acesso à API Gemini.
GEMINI_API_KEY=

# Modelo utilizado pelo sistema.
GEMINI_MODEL=gemini-3.5-flash-lite

# Ativar ou desativar a análise por IA.
# 0 = desativada | 1 = ativada
PRAZUS_IA_ENABLED=1


# ==========================================
# 4. LIMITES DE UTILIZAÇÃO DA IA
# ==========================================

# Máximo de análises por execução.
PRAZUS_IA_MAX_POR_EXECUCAO=1

# Limite diário de chamadas à IA.
PRAZUS_IA_LIMITE_DIARIO=1


# ==========================================
# 5. CONFIGURAÇÕES DO SQLALCHEMY
# ==========================================

# 0 = não exibir consultas SQL no terminal
# 1 = exibir consultas SQL no terminal
SQLALCHEMY_ECHO=0
