
# ==========================================
# PRAZUS - GITIGNORE
# ==========================================
# Protege arquivos privados e remove
# arquivos gerados durante o desenvolvimento.
# ==========================================


# ==========================================
# 1. CREDENCIAIS E CONFIGURAÇÕES PRIVADAS
# ==========================================

.env
.env.*
!.env.example

**/.env
**/.env.*
!**/.env.example

.envrc

*.pem
*.key


# ==========================================
# 2. AMBIENTES VIRTUAIS PYTHON
# ==========================================

venv/
.venv/
env/
ENV/

venv.bak/
env.bak/


# ==========================================
# 3. CACHE E ARQUIVOS PYTHON
# ==========================================

__pycache__/
*.py[cod]
*$py.class

*.so
.Python


# ==========================================
# 4. BUILD E DISTRIBUIÇÃO
# ==========================================

build/
dist/
*.egg-info/
.eggs/
*.egg

pip-log.txt
pip-delete-this-directory.txt


# ==========================================
# 5. TESTES E RELATÓRIOS
# ==========================================

.pytest_cache/
.hypothesis/
.tox/
.nox/

.mypy_cache/
.pyre/
.pytype/
.ruff_cache/

.coverage
.coverage.*

htmlcov/
coverage.xml

*.cover
*.py.cover

.cache/


# ==========================================
# 6. LOGS E ARQUIVOS TEMPORÁRIOS
# ==========================================

logs/
**/logs/

*.log
*.tmp
*.bak
*.swp

.DS_Store
Thumbs.db

instance/
.webassets-cache/


# ==========================================
# 7. BACKUPS DO BANCO DE DADOS
# ==========================================

backups/
**/backups/

backups_estimativas/
**/backups_estimativas/

*.sql.gz
*.sql.bak
*.dump

*backup*.sql
*dump*.sql


# ==========================================
# 8. ARQUIVOS SQL LOCAIS
# ==========================================

# Arquivos gerados pelo SQLTools
*.session.sql

# Arquivos SQL soltos na raiz
/*.sql

# Scripts de estrutura e migrações
# devem continuar no repositório.
!back/database/*.sql
!back/backend/migrations/*.sql


# ==========================================
# 9. CONFIGURAÇÕES DE EDITORES
# ==========================================

.vscode/
.idea/

tempCodeRunnerFile.py


# ==========================================
# 10. JUPYTER
# ==========================================

.ipynb_checkpoints/


# ==========================================
# 11. OUTRAS CONFIGURAÇÕES PRIVADAS
# ==========================================

.streamlit/secrets.toml
.pypirc

back/atualizacao_estrutura/

logs-antigos/
